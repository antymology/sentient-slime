{
  "type": "origins:multiple",
  "visual": {
    "type": "origins:model_color",
    "red": 0.2,
    "blue": 0.15,
    "alpha": 0.7
  },
  "inventory": {
    "type": "sentient_slime:slime_inventory",
    "title": " ",
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  },
  "reset": {
    "type": "origins:action_on_callback",
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "scale reset @s"
    }
  },
  "slimeballs": {
    "type": "origins:action_over_time",
    "interval": 12000,
    "entity_action": {
      "type": "origins:chance",
      "chance": 0.5,
      "action": {
        "type": "origins:execute_command",
        "command": "summon item ~ ~1 ~ {PickupDelay:0,Motion:[-0.1,0.15,0.05],Item:{id:\"minecraft:slime_ball\",Count:1b}}"
      }
    }
  },
  "tooltip": {
    "type": "origins:tooltip",
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:slime_ball"
      }
    },
    "texts": [
      {"text": "Can be used on other players to give","color": "#07C900"}, {"text": "them your bouncing, temporarily.","color": "#07C900"}
    ]
  },
  "use_ball": {
    "type": "origins:action_on_entity_use",
    "bientity_action": {
      "type": "origins:target_action",
      "action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:apply_effect",
            "effect": {
              "effect": "simple_slime:bouncy",
              "duration": 1200,
              "amplifier": 0
            }
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:block",
              "params": "minecraft:slime_block"
            },
            "count": 22,
            "speed": 0.3,
            "force": true
          },
          {
            "type": "origins:play_sound",
            "sound": "entity.slime.squish",
            "pitch": 1.4
          }
        ]
      }
    },
    "held_item_action": {
      "type": "origins:consume",
      "amount": 1
    },
    "bientity_condition": {
      "type": "origins:target_condition",
      "condition": {
        "type": "origins:living"
      }
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:slime_ball"
      }
    },
    "hands": [
      "main_hand"
    ]
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": [
        "Open yourself with [",{"keybind":"key.origins.primary_active","color":"#07C900"},"]."
      ]
    },
    {
      "type": "origins:tooltip",
      "sprite": "sentient_slime:textures/gui/badge/slime.png",
      "text": "You occasionally excrete slimeballs, which can be used on others to give them your power temporarily."
    }
  ]
}